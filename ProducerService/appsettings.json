{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KafkaProducer": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "scrapper",
    "MainTopic": "messages",
    "EnableIdempotence": true,
    "Acks": "All",
    "CompressionType": "Gzip",
    "MessageSendMaxRetries": 3
  },
  "SchemaRegistryUrl": "http://localhost:8081"
}
