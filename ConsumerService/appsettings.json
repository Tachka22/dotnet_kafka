{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KafkaConsumer": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "bot",
    "MainTopic": "messages",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false
  },
  "RetrySettings": {
    "MaxRetryAttempts": 3,
    "DeadLetterTopic": "messages-dlq"
  },
  "SchemaRegistryUrl": "http://localhost:8081"
}
